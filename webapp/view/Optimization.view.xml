<mvc:View
	controllerName="ui5.echarts.app.controller.Optimization"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:layout="sap.ui.layout"
	xmlns:html="http://www.w3.org/1999/xhtml"
	xmlns:app="ui5.echarts.app.controls"
	displayBlock="true">
	<Page
		title="Performance Optimization"
		showNavButton="true"
		navButtonPress="onNavBack">
		<headerContent>
			<Select
				id="scenarioSelect"
				items="{/scenarios}"
				selectedKey="{/selectedScenario}"
				change="onScenarioChange">
				<items>
					<core:Item key="{key}" text="{text}" />
				</items>
			</Select>
		</headerContent>
		<content>
			<VBox class="obsOptLayout">
				<!-- Description -->
				<Text text="{/description}" class="obsOptDescription" />

				<!-- Comparison charts side by side -->
				<html:div class="obsCompareGrid">
					<!-- Before -->
					<html:div class="obsCompareCard">
						<html:div class="obsCompareHeader">
							<html:span class="obsCompareBadge before">BEFORE</html:span>
							<html:span class="obsCompareTitle">Unoptimized</html:span>
						</html:div>
						<app:EChart
							id="chartBefore"
							width="100%"
							height="360px" />
					</html:div>
					<!-- After -->
					<html:div class="obsCompareCard">
						<html:div class="obsCompareHeader">
							<html:span class="obsCompareBadge after">AFTER</html:span>
							<html:span class="obsCompareTitle">Optimized</html:span>
						</html:div>
						<app:EChart
							id="chartAfter"
							width="100%"
							height="360px" />
					</html:div>
				</html:div>

				<!-- Performance metrics table -->
				<Table
					id="performanceTable"
					items="{/performanceData}"
					busy="{/measuring}"
					busyIndicatorDelay="0">
					<columns>
						<Column><Text text="METRIC" /></Column>
						<Column><Text text="BEFORE" /></Column>
						<Column><Text text="AFTER" /></Column>
						<Column><Text text="IMPROVEMENT" /></Column>
					</columns>
					<items>
						<ColumnListItem>
							<cells>
								<Text text="{metric}" />
								<Text text="{before}" />
								<Text text="{after}" />
								<Text text="{improvement}" class="{improvementClass}" />
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>
		</content>
	</Page>
</mvc:View>
